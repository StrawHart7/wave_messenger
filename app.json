{
  "expo": {
    "name": "Wave",
    "slug": "wave-messenger",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wave",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5faff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.strawhart.wave",
      "infoPlist": {
        "NSCameraUsageDescription": "Wave uses the camera for video calls, photos and status updates.",
        "NSMicrophoneUsageDescription": "Wave uses the microphone for voice notes and calls.",
        "NSContactsUsageDescription": "Wave matches your address book to find which of your contacts are on Wave.",
        "NSPhotoLibraryUsageDescription": "Wave uses your photo library to send photos and post status updates.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      }
    },
    "android": {
      "package": "com.strawhart.wave",
      "adaptiveIcon": {
        "backgroundColor": "#25D366",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-image",
      "expo-audio",
      "expo-video",
      "expo-notifications",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
