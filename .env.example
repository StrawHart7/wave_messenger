EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Calls. STUN alone connects roughly four calls in five; the fifth is behind a
# symmetric NAT and needs TURN to relay. Leaving TURN blank is what produces
# "it works on wifi but not on 4G".
EXPO_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=
